                                      "margin-right": "0.25rem",
                                    }}
                                  >
                                    {judge.score === 1 ? "✓" : judge.score === 0 ? "✗" : judge.score}
                                  </span>
                                )}
                              </For>
                            </td>
                          )}
                        </For>
                      </tr>
                    )}
