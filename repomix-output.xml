    } finally {
      if (originalEnv === undefined) {
        delete process.env["OPENCODE_DISABLE_PROJECT_CONFIG"]
      } else {
        process.env["OPENCODE_DISABLE_PROJECT_CONFIG"] = originalEnv
      }
    }
  })

