test("sidebar can be collapsed and expanded", async ({ page, gotoSession }) => {
  await gotoSession()

  const main = page.locator("main")
  const closedClass = /xl:border-l/
  const isClosed = await main.evaluate((node) => node.className.includes("xl:border-l"))

  if (isClosed) {
