        gap: 24px;
      }

      [data-slot="name"] {
        display: flex;
        gap: 16px;

        strong {
          font-weight: 500;
          flex: 0 0 auto;
        }

        span {
          color: var(--color-text);
        }

        @media (max-width: 30rem) {
          flex-direction: column;
          gap: 8px;
        }

        span {
          display: inline-block;
        }

        img {
