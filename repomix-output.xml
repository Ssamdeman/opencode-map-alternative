[data-component="resize-handle"] {
  position: absolute;
  z-index: 10;

  &::after {
    content: "";
    position: absolute;
    opacity: 0;
    transition: opacity 0.15s ease-in-out;
  }

  &:hover::after,
  &:active::after {
    opacity: 1;
  }

  &[data-direction="horizontal"] {
    inset-block: 0;
